# LLM
ANTHROPIC_API_KEY=your_anthropic_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# Vector DB - Qdrant
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=                          # leave blank for local
QDRANT_COLLECTION_NAME=fintech_docs

# Embeddings
EMBEDDING_MODEL=text-embedding-3-large
EMBEDDING_DIMENSIONS=3072

# LLM
LLM_MODEL=claude-sonnet-4-6
LLM_MAX_TOKENS=4096
LLM_TEMPERATURE=0.0

# Chunking
CHUNK_SIZE=1024
CHUNK_OVERLAP=128

# Retrieval
TOP_K_DENSE=10
TOP_K_SPARSE=10
TOP_K_FINAL=5

# SEC EDGAR (required for fetching filings — use your real email)
SEC_CONTACT_EMAIL=your_email@example.com

# API
API_HOST=0.0.0.0
API_PORT=8000
